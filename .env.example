# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
TOTAL_SHARDS=auto

# Postgres
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

# Redis
REDIS_URL=redis://localhost:6379

# App
LOG_LEVEL=info
NODE_ENV=development

# Anti-nuke / anti-raid tuning (defaults used if unset)
ANTI_NUKE_ACTION_THRESHOLD=3
ANTI_NUKE_WINDOW_SECONDS=10
ANTI_RAID_HEAT_THRESHOLD=70
ANTI_RAID_WINDOW_SECONDS=30
