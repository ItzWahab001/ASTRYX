<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DYNEX · <%= guild.name %></title><link rel="stylesheet" href="/app.css"></head><body><nav><b>DYNEX</b><div><a href="/dashboard">Servers</a><a href="/logout">Logout</a></div></nav><main class="wide"><header class="pagehead"><div><span class="pill">CONTROL CENTER 3.0</span><h1><%= guild.name %></h1><p><%= guild.memberCount %> members · WebSocket <%= guild.client.ws.ping %>ms</p></div></header><div class="layout"><aside class="sidebar"><a class="<%= activeSection==='overview'?'active':'' %>" href="/dashboard/<%= guild.id %>/overview">Overview</a><a class="<%= activeSection==='moderation'?'active':'' %>" href="/dashboard/<%= guild.id %>/moderation">Moderation</a><a class="<%= activeSection==='automod'?'active':'' %>" href="/dashboard/<%= guild.id %>/automod">AutoMod</a><a class="<%= activeSection==='security'?'active':'' %>" href="/dashboard/<%= guild.id %>/security">Security</a><a class="<%= activeSection==='antiraid'?'active':'' %>" href="/dashboard/<%= guild.id %>/antiraid">Anti-Raid</a><a class="<%= activeSection==='antinuke'?'active':'' %>" href="/dashboard/<%= guild.id %>/antinuke">Anti-Nuke</a><a class="<%= activeSection==='tickets'?'active':'' %>" href="/dashboard/<%= guild.id %>/tickets">Tickets</a><a class="<%= activeSection==='music'?'active':'' %>" href="/dashboard/<%= guild.id %>/music">Music</a><a class="<%= activeSection==='welcome'?'active':'' %>" href="/dashboard/<%= guild.id %>/welcome">Welcome</a><a class="<%= activeSection==='roles'?'active':'' %>" href="/dashboard/<%= guild.id %>/roles">Roles</a><a class="<%= activeSection==='leveling'?'active':'' %>" href="/dashboard/<%= guild.id %>/leveling">Leveling</a><a class="<%= activeSection==='economy'?'active':'' %>" href="/dashboard/<%= guild.id %>/economy">Economy</a><a class="<%= activeSection==='giveaways'?'active':'' %>" href="/dashboard/<%= guild.id %>/giveaways">Giveaways</a><a class="<%= activeSection==='ai'?'active':'' %>" href="/dashboard/<%= guild.id %>/ai">AI</a><a class="<%= activeSection==='logging'?'active':'' %>" href="/dashboard/<%= guild.id %>/logging">Logging</a><a class="<%= activeSection==='custom-commands'?'active':'' %>" href="/dashboard/<%= guild.id %>/custom-commands">Custom Commands</a><a class="<%= activeSection==='settings'?'active':'' %>" href="/dashboard/<%= guild.id %>/settings">Settings</a></aside><section class="content"><section class="cards"><article class="card"><small>SECURITY</small><strong><%= security.raid_mode?'RAID MODE':'PROTECTED' %></strong><span>Anti-Nuke <%= settings.antinuke_enabled?'ON':'OFF' %> · Anti-Raid <%= settings.antiraid_enabled?'ON':'OFF' %></span></article><article class="card"><small>AUTOMOD</small><strong><%= automod.length %> rules</strong><span>Native Discord enforcement</span></article><article class="card"><small>TICKETS</small><strong><%= (tickets.find(x=>x.status==='open')||{count:0}).count %> open</strong><span>Persistent lifecycle</span></article><article class="card"><small>MUSIC</small><strong><%= music.current?'Playing':'Idle' %></strong><span><%= music.queue.length %> queued · <%= music.volume %>%</span></article></section><div class="panel"><h2>Overview</h2><div class="stats"><span>Uptime <b><%= Math.floor(guild.client.uptime/1000) %>s</b></span><span>Latency <b><%= guild.client.ws.ping %>ms</b></span><span>Incidents <b><%= incidents.length %></b></span></div></div><div class="panel section-panel"><div class="section-heading"><div><span class="pill <%= sectionMeta.mode==='control'?'control':'monitoring' %>"><%= sectionMeta.mode==='control'?'CONTROL':'MONITORING ONLY' %></span><h2><%= sectionMeta.label %></h2></div><small><%= sectionMeta.mode==='control'?'Changes are validated server-side and audited.':'This section is read-only because no dedicated mutation API exists for it yet. DYNEX does not present decorative controls as functional settings.' %></small></div><% if(activeSection==='automod'){ %><div class="control-toolbar"><button class="btn primary" type="button" data-control="automod" data-enabled="1">Enable AutoMod</button><button class="btn" type="button" data-control="automod" data-enabled="0">Disable AutoMod</button><span id="control-result" class="muted"></span></div><div class="list"><% if(!automod.length){ %><div class="empty">No locally tracked AutoMod rules.</div><% } else { automod.forEach(x=>{ %><div><b><%= x.name %></b><small><%= x.enabled?'Enabled':'Disabled' %> · <%= x.rule_id %></small></div><% }) } %></div><% } else if(activeSection==='tickets'){ %><div class="stats"><% tickets.forEach(x=>{ %><span><%= x.status %> <b><%= x.count %></b></span><% }) %></div><% } else if(activeSection==='music'){ %><div class="stats"><span>State <b><%= music.current?'Playing':'Idle' %></b></span><span>Queue <b><%= music.queue.length %></b></span><span>Volume <b><%= music.volume %>%</b></span></div><% } else if(['security','antiraid','antinuke'].includes(activeSection)){ %><div class="control-toolbar"><% if(activeSection==='security'||activeSection==='antiraid'){ %><button class="btn" type="button" data-security-control="antiraid_enabled" data-enabled="<%= settings.antiraid_enabled?'0':'1' %>"><%= settings.antiraid_enabled?'Disable':'Enable' %> Anti-Raid</button><% } %><% if(activeSection==='security'||activeSection==='antinuke'){ %><button class="btn" type="button" data-security-control="antinuke_enabled" data-enabled="<%= settings.antinuke_enabled?'0':'1' %>"><%= settings.antinuke_enabled?'Disable':'Enable' %> Anti-Nuke</button><% } %><% if(activeSection==='security'||activeSection==='antiraid'||activeSection==='antinuke'){ %><button class="btn" type="button" data-security-action="lockdown">Lockdown</button><button class="btn" type="button" data-security-action="unlock">Unlock</button><% } %><span id="control-result" class="muted"></span></div><div class="stats"><span>Raid Mode <b><%= security.raid_mode?'ON':'OFF' %></b></span><span>Anti-Raid <b><%= settings.antiraid_enabled?'ON':'OFF' %></b></span><span>Anti-Nuke <b><%= settings.antinuke_enabled?'ON':'OFF' %></b></span></div><% } else if(activeSection==='settings'){ %><div class="empty">Use the verified settings controls below. Resource selectors are populated from the current Discord guild.</div><% } else { %><div class="empty">Live telemetry is available for this subsystem. No mutation controls are shown because this dashboard section is monitoring-only.</div><% } %></div><div class="panel"><h2>Recent security incidents</h2><% if(!incidents.length){ %><div class="empty">No security incidents recorded.</div><% } else { incidents.forEach(x=>{ %><div class="list"><div><b><%= x.incident_id %></b><small><%= x.event_type %> · <%= x.action %></small></div></div><% }) } %></div><div class="panel"><h2>Recent security events</h2><% if(!recentSecurity.length){ %><div class="empty">No recent events.</div><% } else { recentSecurity.forEach(x=>{ %><div class="list"><div><b><%= x.event_type %></b><small><%= x.details||'' %></small></div></div><% }) } %></div><% if(activeSection==='settings'){ %><div class="panel"><h2>Server settings</h2><form id="settings" method="post" action="/dashboard/<%= guild.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><label>Prefix<input name="prefix" maxlength="5" value="<%= settings.prefix %>"></label><label>Welcome channel<select name="welcome_channel_id"><option value="">Off</option><% guild.channels.cache.filter(c=>c.isTextBased()).forEach(c=>{ %><option value="<%= c.id %>" <%= settings.welcome_channel_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Ticket category<select name="ticket_category_id"><option value="">Not set</option><% guild.channels.cache.filter(c=>c.type===4).forEach(c=>{ %><option value="<%= c.id %>" <%= settings.ticket_category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Ticket staff role<select name="ticket_staff_role_id"><option value="">Not set</option><% guild.roles.cache.filter(r=>r.id!==guild.id).sort((a,b)=>b.position-a.position).forEach(r=>{ %><option value="<%= r.id %>" <%= settings.ticket_staff_role_id===r.id?'selected':'' %>><%= r.name %></option><% }) %></select></label></div><div class="checks"><label><input type="checkbox" name="level_enabled" <%= settings.level_enabled?'checked':'' %>> Leveling</label><label><input type="checkbox" name="economy_enabled" <%= settings.economy_enabled?'checked':'' %>> Economy</label><label><input type="checkbox" name="ai_enabled" <%= settings.ai_enabled?'checked':'' %>> AI</label><label><input type="checkbox" name="antiraid_enabled" <%= settings.antiraid_enabled?'checked':'' %>> Anti-Raid</label><label><input type="checkbox" name="antinuke_enabled" <%= settings.antinuke_enabled?'checked':'' %>> Anti-Nuke</label><label><input type="checkbox" name="automod_enabled" <%= settings.automod_enabled?'checked':'' %>> AutoMod</label></div><button class="btn primary" id="save-settings" type="submit">Save settings</button></form></div><% } %></section></div></main></body></html>
<script>
(()=> {
  const csrf=<%- JSON.stringify(csrf) %>;
  const guildId=<%- JSON.stringify(guild.id) %>;
  const result=document.getElementById('control-result');
  async function post(path,body){
    const response=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify(body)});
    const data=await response.json().catch(()=>({success:false,error:'Invalid server response'}));
    if(!response.ok||!data.success)throw new Error(data.error||'Request failed');
    return data;
  }
  document.querySelectorAll('[data-control="automod"]').forEach(button=>{
    button.addEventListener('click',async()=>{
      button.disabled=true;
      try{
        const data=await post(`/api/guild/${guildId}/automod/toggle`,{enabled:button.dataset.enabled==='1'});
        if(result)result.textContent=`AutoMod ${data.enabled?'enabled':'disabled'} · ${data.changed} rule(s) updated`;
        setTimeout(()=>location.reload(),500);
      }catch(error){if(result)result.textContent=error.message}
      finally{button.disabled=false}
    });
  });
  document.querySelectorAll('[data-security-control]').forEach(button=>{
    button.addEventListener('click',async()=>{
      button.disabled=true;
      try{
        const data=await post(`/api/guild/${guildId}/security/toggle`,{control:button.dataset.securityControl,enabled:button.dataset.enabled==='1'});
        if(result)result.textContent=`${data.control} ${data.enabled?'enabled':'disabled'}`;
        setTimeout(()=>location.reload(),500);
      }catch(error){if(result)result.textContent=error.message}
      finally{button.disabled=false}
    });
  });
  document.querySelectorAll('[data-security-action]').forEach(button=>{
    button.addEventListener('click',async()=>{
      button.disabled=true;
      try{
        const data=await post(`/api/guild/${guildId}/security/${button.dataset.securityAction}`);
        if(result)result.textContent=data.lockdown?'Security lockdown enabled':'Security lockdown released';
        setTimeout(()=>location.reload(),500);
      }catch(error){if(result)result.textContent=error.message}
      finally{button.disabled=false}
    });
  });
  document.getElementById('settings')?.addEventListener('submit',()=>{
    const b=document.getElementById('save-settings');if(b){b.disabled=true;b.textContent='Saving…'}
  });
})();
</script>