{
  "name": "dynex-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @dynex/bot --filter @dynex/dashboard dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start:bot": "pnpm --filter @dynex/bot start",
    "start:dashboard": "pnpm --filter @dynex/dashboard start",
    "prestart:bot": "pnpm --filter @dynex/database migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
